# Base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/securite_sociale

# Secret JWT (même valeur que NEXTAUTH_SECRET côté Next.js)
NEXTAUTH_SECRET=your-secret-key-min-32-chars

# Environnement — "development" active le CORS wildcard pour les tests locaux
# Mettre "production" pour restreindre CORS à FRONTEND_URL uniquement
ENVIRONMENT=development

# URL du frontend (utilisée en production pour restreindre CORS)
FRONTEND_URL=http://localhost:3000

# Serveur
HOST=0.0.0.0
PORT=8000
